{
  "name": "rattata-lab",
  "productName": "Rattata Labs",
  "version": "2.1.4",
  "description": "Rattata Labs: Damage Calculator, Teambuilder, Meta-Test, Nationaler Pokédex, Fangrechner, Soul-Link-Planer, Nuzlocke-Rechner (Alpha), Save File Editor (Beta), Shiny-Zähler, Team-Analyse, Speed-Tiers, Minigames und Match-Overlays für OBS",
  "author": "HohnWolf",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run_all.js",
    "matchlog": "node test/matchlog_harness.js",
    "dist": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:dir": "electron-builder --win dir",
    "release": "electron-builder --win nsis portable --publish always"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.11",
    "jpeg-js": "^0.4.4"
  },
  "build": {
    "appId": "de.hohnwolf.championscalc",
    "productName": "Rattata Labs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "icon.ico",
      "icon_shiny.ico",
      "icon.png",
      "css/**",
      "js/**",
      "data/**",
      "img/**",
      "electron/**",
      "vendor/ps/**",
      "vendor/tessdata/**",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": true
    },
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "RattataLab-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rattata Labs",
      "artifactName": "RattataLab-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "RattataLab-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HohnWolf",
        "repo": "DamageCalc",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@39.8.10": true
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "tesseract.js": "^5.1.1"
  }
}
