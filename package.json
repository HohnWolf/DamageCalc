{
  "name": "rattata-lab",
  "productName": "Rattata Labs",
  "version": "1.22.0",
  "description": "Rattata Labs: Damage Calculator, Teambuilder, Nationaler Pokédex, Fangrechner, Soul-Link-Planer, Nuzlocke-Rechner (Alpha), Save File Editor (Beta), Shiny-Zähler, Team-Analyse, Minigames und Match-Overlays für OBS",
  "author": "HohnWolf",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run_all.js",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win dir",
    "release": "electron-builder --win nsis portable --publish always",
    "build:sim": "esbuild js/sim_worker.js --bundle --minify --outfile=js/sim_worker.bundle.js --format=iife --target=es2020",
    "train:ai": "node ml/master_loop_20.js 30 5000 --reset",
    "train:quick": "node ml/master_loop_20.js 10 2000 --reset"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "de.hohnwolf.championscalc",
    "productName": "Rattata Labs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "icon.ico",
      "icon_shiny.ico",
      "css/**",
      "!css/sim.css",
      "js/**",
      "!js/sim_*",
      "data/**",
      "!data/meta_archetypes.js",
      "!data/ai_weights.json",
      "img/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rattata Labs",
      "artifactName": "RattataLab-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "RattataLab-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HohnWolf",
        "repo": "DamageCalc",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@39.8.10": true
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "@pkmn/sim": "^0.10.12"
  }
}
