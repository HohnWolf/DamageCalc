{
  "name": "rattata-lab",
  "productName": "Rattata Lab",
  "version": "1.2.0",
  "description": "Rattata Lab: Damage Calculator und Teambuilder für Pokémon Champions, Soul-Link-Planer, Nuzlocke-Rechner (Alpha) und Shiny-Zähler",
  "author": "HohnWolf",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "de.hohnwolf.championscalc",
    "productName": "Rattata Lab",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "icon.ico",
      "css/**",
      "js/**",
      "data/**",
      "img/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rattata Lab",
      "artifactName": "RattataLab-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "RattataLab-${version}-portable.${ext}"
    }
  },
  "allowScripts": {
    "electron@39.8.10": true
  }
}
